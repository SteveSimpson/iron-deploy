#!/bin/bash

mkdir -p .ca

cat > ./.ca/openssl.conf << 'EOL'
[ req ]
default_bits       = 4096
distinguished_name = req_distinguished_name
req_extensions     = v3_req
x509_extensions    = v3_req
prompt            = no

[ req_distinguished_name ]
CN                = iron-deploy

[ v3_req ]
basicConstraints  = CA:FALSE
keyUsage         = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName   = @alt_names

[ alt_names ]
DNS.1            = logger
DNS.2            = gitlab
DNS.3            = maildev
DNS.4            = nifi
DNS.5            = mockserver
IP.1             = 127.0.0.1
EOL

# Generate CA key and certificate
openssl genrsa -out ./.ca/ca.key 4096
openssl req -new -x509 -days 3650 -key ./.ca/ca.key -out ./.ca/ca.crt -subj "/CN=Iron Deploy CA"

# Generate server key and CSR using the config file
openssl genrsa -out ./.ca/server.key 2048
openssl req -new -key ./.ca/server.key -out ./.ca/server.csr -config ./.ca/openssl.conf

# Sign the certificate with our CA
openssl x509 -req -days 3650 -in ./.ca/server.csr -CA ./.ca/ca.crt -CAkey ./.ca/ca.key \
    -CAcreateserial -out ./.ca/server.crt -extensions v3_req -extfile ./.ca/openssl.conf

# Get a traditional CA RSA PKCS8 key
openssl rsa -in ca.key -out ca_pkcs8_key.pem -traditional 

# Be able to view the cert info
openssl x509 -noout -text -in ./.ca/server.crt > ./.ca/server.text

# Make a combined file for HA Proxy
cat ./.ca/server.crt > ./.ca/combined.pem
cat ./.ca/server.key >> ./.ca/combined.pem
